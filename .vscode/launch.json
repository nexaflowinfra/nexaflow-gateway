{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run NexaFlow Gateway",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "envFile": "${workspaceFolder}\\.env",
      "justMyCode": true
    }
  ]
}
